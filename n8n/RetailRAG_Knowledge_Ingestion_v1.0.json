    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.content ?? '';\n\nfunction getField(label) {\n  const escaped = label.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  const regex = new RegExp(`\\\\*\\\\*${escaped}:\\\\*\\\\*\\\\s*([^\\\\r\\\\n]+)`, 'i');\n  const match = text.match(regex);\n\n  return match ? match[1].trim() : null;\n}\n\nfunction normalizeDate(value) {\n  if (!value) return null;\n\n  const date = new Date(`${value} 00:00:00 UTC`);\n\n  if (Number.isNaN(date.getTime())) {\n    return value;\n  }\n\n  return date.toISOString().slice(0, 10);\n}\n\nconst documentId = getField('Document ID');\nconst documentTitle = getField('Document Title');\nconst version = getField('Version');\nconst status = getField('Status');\nconst effectiveDate = getField('Effective Date');\nconst archivedDate = getField('Archived Date');\nconst replacedBy = getField('Replaced By');\nconst department = getField('Department');\nconst audienceRaw = getField('Audience');\n\nconst sourceFile =\n  $('List Knowledge Base Files').item.json.name ?? null;\n\nconst sourceFileId =\n  $('List Knowledge Base Files').item.json.id ?? null;\n\nreturn {\n  content: text.trim(),\n\n  metadata: {\n    document_id: documentId,\n    document_title: documentTitle,\n    version: version,\n    status: status ? status.toLowerCase() : null,\n    effective_date: normalizeDate(effectiveDate),\n    archived_date: normalizeDate(archivedDate),\n    replaced_by: replacedBy,\n    department: department,\n    audience: audienceRaw\n      ? audienceRaw.split(',').map(v => v.trim())\n      : [],\n    source_file: sourceFile,\n    source_file_id: sourceFileId\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
